{
  "model_type": "DiffCSP",
  "framework": "PaddlePaddle",
  "framework_version": "3.3.0",
  "model_name": "diffcsp_mp20",
  "model_config": {
    "__class_name__": "DiffCSP",
    "__init_params__": {
      "decoder_cfg": {
        "hidden_dim": 512,
        "latent_dim": 256,
        "num_layers": 6,
        "act_fn": "silu",
        "dis_emb": "sin",
        "num_freqs": 128,
        "edge_style": "fc",
        "ln": true,
        "ip": true,
        "smooth": false,
        "pred_type": false,
        "prop_dim": 512,
        "pred_scalar": false,
        "num_classes": 100
      },
      "lattice_noise_scheduler_cfg": {
        "__class_name__": "DDPMScheduler",
        "__init_params__": {
          "beta_schedule": "squaredcos_cap_v2",
          "num_train_timesteps": 1000,
          "clip_sample": false
        }
      },
      "coord_noise_scheduler_cfg": {
        "__class_name__": "ScoreSdeVeSchedulerWrapped",
        "__init_params__": {
          "num_train_timesteps": 1000,
          "sigma_min": 0.005,
          "sigma_max": 0.5,
          "snr": 1e-05
        }
      },
      "num_train_timesteps": 1000,
      "time_dim": 256,
      "lattice_loss_weight": 1,
      "coord_loss_weight": 1
    }
  }
}